<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esmis_approval_definition_form" model="ir.ui.view">
        <field name="name">esmis.approval.definition.form</field>
        <field name="model">esmis.approval.definition</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Enrollment Approval"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_esmis_approval_definition_list" model="ir.ui.view">
        <field name="name">esmis.approval.definition.list</field>
        <field name="model">esmis.approval.definition</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_id"/>
            </list>
        </field>
    </record>

    <record id="action_esmis_approval_definition" model="ir.actions.act_window">
        <field name="name">Approval Definitions</field>
        <field name="res_model">esmis.approval.definition</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
