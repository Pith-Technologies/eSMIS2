<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esmis_address_form_inline" model="ir.ui.view">
        <field name="name">esmis.address.form.inline</field>
        <field name="model">esmis.address</field>
        <field name="arch" type="xml">
            <form string="Address">
                <group>
                    <group>
                        <field name="address_type_id"/>
                        <field name="is_primary"/>
                    </group>
                    <group>
                        <field name="country_id"/>
                        <field name="postal_code"/>
                    </group>
                </group>
                <group>
                    <field name="street1"/>
                    <field name="street2"/>
                    <field name="city"/>
                    <field name="state_province"/>
                </group>
                <field name="notes" placeholder="Additional notes..."/>
            </form>
        </field>
    </record>

    <record id="view_esmis_address_list" model="ir.ui.view">
        <field name="name">esmis.address.list</field>
        <field name="model">esmis.address</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="address_type_id"/>
                <field name="is_primary"/>
                <field name="address_text"/>
            </list>
        </field>
    </record>
</odoo>
