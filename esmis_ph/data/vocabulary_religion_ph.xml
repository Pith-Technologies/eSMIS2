<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Religious affiliations for Philippine HEI demographic reporting -->
    <record id="vocab_religion_ph" model="esmis.vocabulary">
        <field name="name">Religion (Philippines)</field>
        <field name="namespace_uri">urn:esmis:religion-ph</field>
        <field name="version">1.0</field>
        <field name="description">Religious affiliation codes for Philippine higher education demographic reporting. Based on PSA census classifications.</field>
        <field name="is_system" eval="True"/>
        <field name="domain">regulatory</field>
    </record>

    <record id="code_religion_roman_catholic" model="esmis.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_religion_ph"/>
        <field name="code">roman_catholic</field>
        <field name="display">Roman Catholic</field>
        <field name="sequence">10</field>
    </record>

