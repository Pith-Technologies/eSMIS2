<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Philippine ethno-linguistic groups for CHED HEMIS reporting -->
    <record id="vocab_ethnicity_ph" model="esmis.vocabulary">
        <field name="name">Ethnicity (Philippines)</field>
        <field name="namespace_uri">urn:esmis:ethnicity-ph</field>
        <field name="version">1.0</field>
        <field name="description">Philippine ethno-linguistic group classification used for CHED HEMIS demographic reporting and Indigenous Peoples program eligibility.</field>
        <field name="is_system" eval="True"/>
        <field name="domain">regulatory</field>
    </record>

    <record id="code_ethnicity_tagalog" model="esmis.vocabulary.code">
        <field name="vocabulary_id" ref="vocab_ethnicity_ph"/>
        <field name="code">tagalog</field>
        <field name="display">Tagalog</field>
        <field name="sequence">10</field>
    </record>

