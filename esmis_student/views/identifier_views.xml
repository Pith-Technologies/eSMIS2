<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_esmis_identifier_list" model="ir.ui.view">
        <field name="name">esmis.identifier.list</field>
        <field name="model">esmis.identifier</field>
        <field name="arch" type="xml">
            <list string="Identifiers">
                <field name="partner_id"/>
                <field name="type_id"/>
                <field name="system_uri"/>
            </list>
        </field>
    </record>

    <record id="view_esmis_identifier_form" model="ir.ui.view">
        <field name="name">esmis.identifier.form</field>
        <field name="model">esmis.identifier</field>
        <field name="arch" type="xml">
            <form string="Identifier">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="type_id"/>
                            <field name="system_uri" readonly="1"/>
                        </group>
                        <group>
                            <field name="value"
                                   groups="esmis_student.group_esmis_registrar_officer"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_esmis_identifier_list" model="ir.actions.act_window">
        <field name="name">Identifiers</field>
        <field name="res_model">esmis.identifier</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
